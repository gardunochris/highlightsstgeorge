                "contentAlign": "center",
                "text": "55 S 300 W, St George, UT 84770, US<br>",
                "buttons": "<a data-app-btn=\"true\" class=\"btn display-4 btn-primary\" data-app-placeholder=\"Type Text\" href=\"#contacts1-3\" data-toolbar=\"-mbrBtnMove\"><span class=\"mbri-map-pin mbr-iconfont mbr-iconfont-btn\"></span>VIEW MAP</a> <a data-app-btn=\"true\" class=\"btn display-4 btn-success\" data-app-placeholder=\"Type Text\" href=\"https://www.yelp.com/biz_photos/highlights-by-talynn-st-george\" data-toolbar=\"-mbrBtnMove\"><span class=\"socicon socicon-yelp mbr-iconfont mbr-iconfont-btn\"></span>FIND ME ON YELP</a> ",
                "overlayOpacity": "0.4",
                "overlayColor": "#232323",
                "textTitle": "Located At Elevated Stylez Salon"
              }
            ]
          }
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
